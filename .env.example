# GEMINI_API_KEY: Platform-injected variable (unused unless AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Database Configuration
PORT="3000"
NODE_ENV="development"
BRB_DB_PATH="./data/brb_feed_industry.sqlite"

# Security & OTP Hashing Pepper (replace in production via secret manager)
BRB_OTP_PEPPER="CHANGE_ME_IN_PRODUCTION_RANDOM_64_HEX"

# Optional SMS / OTP Gateway Configuration (can also be configured in Admin Settings)
SMS_PROVIDER_URL=""
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="BRB-FEED"

# Optional Backup Encryption Key
BACKUP_ENCRYPTION_SECRET=""
